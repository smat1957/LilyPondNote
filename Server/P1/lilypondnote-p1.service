[Unit]
Description=LilyPondNote P1 authentication server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lilypondnote-p1
Group=lilypondnote-p1
WorkingDirectory=/opt/lilypondnote/P1
EnvironmentFile=/etc/lilypondnote/p1.env
ExecStart=/opt/lilypondnote/P1/.venv/bin/uvicorn main:app --host 192.168.30.10 --port 8001
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/lilypondnote/P1

[Install]
WantedBy=multi-user.target
